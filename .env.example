# ── Postgres (see docker-compose.yml; note the host port is 5433) ────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ai_column

# ── Redis ───────────────────────────────────────────────────────────────────
# Required by Effect's RateLimiter, whose only non-memory store is Redis. The
# evaluation adapter reports provider responses back through it so the limiter
# learns Jev's undocumented rate limit instead of guessing one.
REDIS_URL=redis://localhost:6379

# ── Object storage (docker-compose.yml `garage` service) ────────────────────
# S3-compatible; the same vars work against AWS S3 in production by pointing
# STORAGE_ENDPOINT at AWS and setting STORAGE_FORCE_PATH_STYLE=false.
STORAGE_ENDPOINT=http://localhost:3900
STORAGE_REGION=garage
STORAGE_BUCKET=ai-column-datasets
STORAGE_ACCESS_KEY_ID=GK97bcef0d8a1e2c3d4e5f60718293a4b5c
STORAGE_SECRET_ACCESS_KEY=27f2c8b9d01a4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e
STORAGE_FORCE_PATH_STYLE=true

# Upload cap. 50 MB, down from the base's 5 GiB single-PUT ceiling.
# See the decision "Dataset privacy and lifecycle".
MAX_DATASET_SIZE_BYTES=52428800

# ── Jev / TypeSafe — the per-row evaluator ──────────────────────────────────
# Verified live. Note the request contract: `choice` takes `criteria` as a
# label -> description MAP, `score` as an ORDERED ARRAY.
JEV_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# ── better-auth ─────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── General-purpose LLM: rule clarification ONLY, never row evaluation ─────
# Unset disables the "Improve this" affordance; the core loop never depends on it.
OPENAI_API_KEY=

# ── OAuth (optional; unset providers simply don't appear) ───────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
